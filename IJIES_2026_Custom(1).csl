<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>IJIES 2026.10.1 (Custom, Revised v2, Unofficial)</title>
    <title-short>IJIES Custom v2</title-short>
    <id>https://github.com/AbidGraini/MANET-Blackhole-Detection/blob/main/IJIES_2026_Custom_v2.csl</id>
    <link href="https://github.com/AbidGraini/MANET-Blackhole-Detection/blob/main/IJIES_2026_Custom_v2.csl" rel="self"/>
    <link href="https://www.inass.org/" rel="documentation"/>
    <author><name>Custom IJIES style adaptation</name></author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Unofficial style based on IJIES 2026.10.1 examples. v2 places commas outside closing quotation marks; keeps initials, numeric order, volume/issue/pages, and DOI. Generic CSL cannot abbreviate arbitrary imported conference proceedings names; verify bibliography before submission.</summary>
    <updated>2026-11-07T00:00:00+00:00</updated>
  </info>

  <!-- IJIES example uses closing quotation mark BEFORE comma, even for English output. -->
  <locale xml:lang="en-US">
    <style-options punctuation-in-quote="false"/>
  </locale>

  <macro name="names">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual"/>
      <substitute><names variable="editor"/></substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" "><text value="pp."/><text variable="page"/></group>
      </if>
    </choose>
  </macro>

  <macro name="journal-details">
    <group delimiter=", ">
      <text variable="container-title"/>
      <choose>
        <if variable="volume">
          <group delimiter=" "><text value="Vol."/><text variable="volume"/></group>
        </if>
      </choose>
      <choose>
        <if variable="issue">
          <group delimiter=" "><text value="No."/><text variable="issue"/></group>
        </if>
      </choose>
      <text macro="pages"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="conference-details">
    <group delimiter=", ">
      <choose>
        <!-- When event name exists, the conference wording is supplied cleanly. -->
        <if variable="event">
          <text variable="event" prefix="In: Proc. of "/>
        </if>
        <else>
          <!-- Keep an imported full proceedings name as-is; do not duplicate 'Proceedings of'. -->
          <text variable="container-title" prefix="In: "/>
        </else>
      </choose>
      <text variable="event-place"/>
      <text macro="pages"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="book-details">
    <group delimiter=", ">
      <choose>
        <if variable="volume">
          <group delimiter=" "><text value="Vol."/><text variable="volume"/></group>
        </if>
      </choose>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="reference-entry">
    <group delimiter=", ">
      <text macro="names"/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=", ">
            <text variable="title" quotes="true"/>
            <text macro="journal-details"/>
          </group>
        </if>
        <else-if type="paper-conference chapter" match="any">
          <group delimiter=", ">
            <text variable="title" quotes="true"/>
            <text macro="conference-details"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text variable="title"/>
            <text macro="book-details"/>
          </group>
        </else>
      </choose>
      <text variable="DOI" prefix="doi: "/>
    </group>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="reference-entry" prefix=" "/>
    </layout>
  </bibliography>
</style>
