<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>IJIES 2026.10.1 (Custom, Revised v5, Unofficial)</title>
    <title-short>IJIES Custom v5</title-short>
    <id>https://raw.githubusercontent.com/AbidGraini/MANET-Blackhole-Detection/main/IJIES_2026_Custom_v5.csl</id>
    <link href="https://raw.githubusercontent.com/AbidGraini/MANET-Blackhole-Detection/main/IJIES_2026_Custom_v5.csl" rel="self"/>
    <link href="https://www.inass.org/" rel="documentation"/>
    <author><name>Custom IJIES style adaptation</name></author>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <summary>Unofficial IJIES 2026.10.1 adaptation. Numeric citations, author initials, quoted article titles with outside commas, volume/issue/pages, books and optional editions, DOI. Conference event titles use In: Proc. of; imported proceedings titles are printed in full. v5 replaces second-field-align with hanging-indent to avoid inserting a tab between reference number and authors. Font family/size remain Word formatting settings.</summary>
    <updated>2026-11-07T20:00:00+00:00</updated>
  </info>

  <!-- IJIES example uses closing quotation mark BEFORE comma, even for English output. -->
  <locale xml:lang="en-US">
    <style-options punctuation-in-quote="false"/>
  </locale>

  <macro name="names">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual"/>
      <substitute><names variable="editor"/></substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <group delimiter=" "><text value="pp."/><text variable="page"/></group>
      </if>
    </choose>
  </macro>

  <macro name="journal-details">
    <group delimiter=", ">
      <text variable="container-title"/>
      <choose>
        <if variable="volume">
          <group delimiter=" "><text value="Vol."/><text variable="volume"/></group>
        </if>
      </choose>
      <choose>
        <if variable="issue">
          <group delimiter=" "><text value="No."/><text variable="issue"/></group>
        </if>
      </choose>
      <text macro="pages"/>
      <text macro="year"/>
    </group>
  </macro>

  <!-- CSL does not support substring replacement of imported conference titles. -->
  <macro name="conference-details">
    <group delimiter=", ">
      <choose>
        <if variable="event-title">
          <text variable="event-title" prefix="In: Proc. of "/>
        </if>
        <else-if variable="event">
          <text variable="event" prefix="In: Proc. of "/>
        </else-if>
        <else>
          <!-- Print full proceedings title and do not add Proc. of when title may already begin Proceedings of. -->
          <text variable="container-title" prefix="In: "/>
        </else>
      </choose>
      <text variable="event-place"/>
      <text macro="pages"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="book-details">
    <group delimiter=", ">
      <choose>
        <if variable="volume">
          <group delimiter=" "><text value="Vol."/><text variable="volume"/></group>
        </if>
      </choose>
      <choose>
        <if variable="edition">
          <group delimiter=" ">
            <number variable="edition" form="ordinal"/>
            <text value="ed."/>
          </group>
        </if>
      </choose>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="year"/>
    </group>
  </macro>

  <macro name="reference-entry">
    <group delimiter=", ">
      <text macro="names"/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=", ">
            <text variable="title" quotes="true"/>
            <text macro="journal-details"/>
          </group>
        </if>
        <else-if type="paper-conference chapter" match="any">
          <group delimiter=", ">
            <text variable="title" quotes="true"/>
            <text macro="conference-details"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text variable="title"/>
            <text macro="book-details"/>
          </group>
        </else>
      </choose>
      <text variable="DOI" prefix="doi: "/>
    </group>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <!-- No second-field-align: suppresses the tab between [n] and author text. Use one normal space. -->
    <layout suffix="." font-weight="normal">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="reference-entry" prefix=" "/>
    </layout>
  </bibliography>
</style>
